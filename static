@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap');
:root{--bg:#171329;--panel:#211c39;--panel2:#292343;--gold:#e7bd76;--cream:#f5ead6;--muted:#b9afc8;--purple:#9b83c8;--green:#8fc6a0;--red:#e58e8e}
*{box-sizing:border-box}html{min-height:100%;background:var(--bg)}body{margin:0;min-height:100vh;color:var(--cream);font-family:'DM Sans',sans-serif;background:radial-gradient(ellipse at 50% 0%,#3a2b54 0%,#211b38 38%,#171329 75%);overflow-x:hidden}
.stars{position:fixed;inset:0;pointer-events:none;opacity:.25;background-image:radial-gradient(#f7d99d 1px,transparent 1px),radial-gradient(#fff 1px,transparent 1px);background-size:83px 83px,137px 137px;background-position:0 0,31px 57px}
.topbar{height:70px;max-width:1100px;margin:auto;padding:0 28px;display:flex;align-items:center;justify-content:space-between;position:relative;z-index:1;border-bottom:1px solid #ffffff12}.brand{font:600 12px 'Cinzel',serif;letter-spacing:2px;color:var(--gold);display:flex;align-items:center;gap:10px}.brand-mark{font-size:23px}.sound-toggle{border:1px solid #ffffff25;background:#ffffff08;color:var(--cream);border-radius:30px;padding:8px 14px;font:inherit;cursor:pointer}
.shell{max-width:900px;margin:0 auto;padding:36px 24px 20px;position:relative;z-index:1}.hero{text-align:center;padding:66px 22px 54px;min-height:610px;display:flex;align-items:center;flex-direction:column;justify-content:center}.eyebrow{font-size:10px;letter-spacing:2.8px;color:var(--gold);font-weight:700}.hero h1{font:700 clamp(35px,7vw,64px)/1.12 'Cinzel',serif;margin:22px 0 18px;color:#fff1d8}.hero h1 span{display:block;color:var(--gold);font-size:.58em;margin-top:10px}.intro{max-width:620px;color:var(--muted);font-size:16px;line-height:1.8;margin:0 auto 24px}.hero-meta{display:flex;gap:20px;flex-wrap:wrap;justify-content:center;color:#d0c2d9;font-size:12px;margin-bottom:34px}.primary-btn,.next-btn{background:linear-gradient(135deg,#f0cf91,#c99553);border:0;color:#261b2d;border-radius:7px;padding:15px 24px;font:700 13px 'DM Sans',sans-serif;letter-spacing:.3px;cursor:pointer;box-shadow:0 8px 30px #d3a45b25;transition:transform .2s,filter .2s}.primary-btn:hover,.next-btn:hover{transform:translateY(-2px);filter:brightness(1.07)}.primary-btn span,.next-btn span{font-size:18px;margin-left:12px}.hero-foot{font:10px 'Cinzel',serif;letter-spacing:2px;color:#8e819f;margin-top:45px}
.hidden{display:none!important}.game{max-width:720px;margin:26px auto 42px}.game-head{display:flex;justify-content:space-between;align-items:center;gap:15px}.game-head h2{font:600 clamp(21px,4vw,30px) 'Cinzel',serif;margin:8px 0 17px}.score-pill{border:1px solid #e7bd7650;color:var(--gold);border-radius:30px;padding:9px 14px;font-size:12px;white-space:nowrap}.progress-track{height:4px;background:#ffffff16;border-radius:5px;margin-bottom:22px;overflow:hidden}.progress-track div{height:100%;width:0;background:var(--gold);transition:width .35s}
.scene-card{background:linear-gradient(120deg,#302747,#242039);border:1px solid #ffffff14;border-radius:13px;padding:22px;display:flex;gap:22px;align-items:center;min-height:150px;box-shadow:0 15px 40px #08061135}.scene-art{width:105px;height:105px;flex:0 0 105px;border-radius:12px;background:radial-gradient(circle,#765d7d,#3c2d4c);display:grid;place-items:center;font-size:52px}.location{font:700 10px 'Cinzel',serif;letter-spacing:2px;color:var(--gold);margin-bottom:9px}.scene-copy p{margin:0;color:#d4cadd;line-height:1.65;font-size:14px}.question-card{background:#f3eadc;color:#30243b;border-radius:13px;margin-top:18px;padding:24px 26px;box-shadow:0 15px 40px #08061135}.question-top{display:flex;justify-content:space-between;gap:10px;color:#94774d;font-size:9px;letter-spacing:1.5px;font-weight:700}.question-card h3{font:600 21px/1.4 'Cinzel',serif;margin:17px 0 20px}.answers{display:grid;grid-template-columns:1fr 1fr;gap:10px}.answer{border:1px solid #d9cdbb;background:#fffaf1;color:#3b3045;border-radius:8px;padding:14px;text-align:left;font:600 13px 'DM Sans',sans-serif;cursor:pointer;min-height:55px;transition:.15s}.answer:hover:not(:disabled){border-color:#b58b52;background:#fff4df;transform:translateY(-1px)}.answer:disabled{cursor:default;opacity:1}.answer.correct{background:#e0f0e3;border-color:#72ad7e;color:#245b34}.answer.wrong{background:#f7e1df;border-color:#d88b85;color:#8b3936}.feedback{margin-top:16px;padding:13px 15px;border-radius:8px;background:#e8dfd1;color:#57465a;font-size:13px;line-height:1.55}.feedback strong{display:block;margin-bottom:3px}.next-btn{margin-top:15px;padding:12px 19px}.game-bottom{display:flex;justify-content:space-between;align-items:center;gap:12px;color:#9f93ad;font-size:11px;margin-top:16px}.game-bottom button,.text-btn{background:none;border:0;color:#c7b7d3;text-decoration:underline;cursor:pointer;font:inherit}.ending{text-align:center;max-width:620px;margin:60px auto 70px;padding:30px 15px}.ending-icon{font-size:70px;margin-bottom:22px;filter:drop-shadow(0 8px 18px #e7bd7640)}.ending h2{font:600 clamp(27px,5vw,42px)/1.2 'Cinzel',serif;margin:18px 0;color:#fff0d5}.ending>p{color:var(--muted);line-height:1.8}.final-score{margin:28px auto 20px;padding:20px;width:210px;border:1px solid #e7bd7655;border-radius:12px;display:flex;flex-direction:column;gap:5px}.final-score span,.final-score small{font-size:10px;letter-spacing:1.5px;color:#b9a9c5}.final-score strong{font:700 48px 'Cinzel',serif;color:var(--gold)}.final-blessing{font:italic 15px 'Cinzel',serif;color:#d9c39c;margin:25px auto 30px;line-height:1.7}.text-btn{display:block;margin:18px auto 0}footer{text-align:center;color:#766b86;font-size:9px;letter-spacing:1.5px;padding:22px 0 10px}
@media(max-width:600px){.topbar{height:58px;padding:0 17px}.shell{padding:16px 15px 15px}.hero{min-height:calc(100svh - 105px);padding:45px 5px}.hero h1{font-size:39px}.intro{font-size:14px}.hero-meta{gap:10px;font-size:10px}.hero-foot{margin-top:34px}.game{margin:18px auto 30px}.game-head{align-items:flex-start}.game-head h2{font-size:22px}.score-pill{padding:8px 10px;font-size:11px}.scene-card{padding:15px;gap:14px;min-height:125px}.scene-art{width:76px;height:76px;flex-basis:76px;font-size:39px}.scene-copy p{font-size:12px}.question-card{padding:19px 15px}.question-top{font-size:8px;letter-spacing:1px}.question-card h3{font-size:18px;margin:14px 0 17px}.answers{grid-template-columns:1fr;gap:8px}.answer{min-height:48px;padding:12px}.game-bottom{font-size:10px}.ending{margin:35px auto 45px}.ending h2{font-size:29px}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
